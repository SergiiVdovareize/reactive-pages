{
  "name": "reactive-pages",
  "version": "0.2.1",
  "homepage": "https://reactive.vdovareize.me",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "gh-pages": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^6.2.2"
  },
  "scripts": {
    "docker:build": "docker build -t reactive-pages .",
    "docker:run": "docker run -p 3003:3003 reactive-pages",
    "start": "PORT=3003 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "postdeploy": "echo 'Reactive deployment initialized'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@ark-ui/react": "^5.39.2",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@testing-library/dom": "^10.4.2",
    "framer-motion": "^14.0.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^@ark-ui/react/(.*)$": "<rootDir>/node_modules/@ark-ui/react/dist/components/$1/index.cjs"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@chakra-ui|@ark-ui|@zag-js|proxy-compare)/)"
    ]
  }
}